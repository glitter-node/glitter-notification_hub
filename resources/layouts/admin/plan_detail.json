{
  "version":"1.0.0","layout_name":"plan_detail","permissions":["glitter-notification_hub.plans.read"],"extends":"_admin_base",
  "meta":{"title":"$t:glitter-notification_hub.admin.pages.plan_detail.title"},
  "initGlobal":{"notificationHubPlanAction":{"reason":"","scheduledAt":"","retryPolicy":"standard","maxAttempts":6,"isSubmitting":false}},
  "data_sources":[
    {"id":"plan","type":"api","endpoint":"/api/modules/glitter-notification_hub/admin/plans/{{route.id}}","method":"GET","auto_fetch":true,"auth_required":true,"errorHandling":{"404":{"handler":"showErrorPage","params":{"target":"content"}}}},
    {"id":"plan_attempts","type":"api","endpoint":"/api/modules/glitter-notification_hub/admin/attempts","method":"GET","auto_fetch":true,"auth_required":true,"params":{"plan_id":"{{route.id}}"}}
  ],
  "slots":{"content":[{"id":"plan_detail_page","type":"basic","name":"Div","props":{"className":"admin-page-content"},"children":[
    {"type":"composite","name":"PageHeader","props":{"title":"$t:glitter-notification_hub.admin.pages.plan_detail.title","description":"$t:glitter-notification_hub.admin.pages.plan_detail.description"}},
    {"type":"basic","name":"Badge","props":{"label":"{{plan.data?.status_label ?? '-'}}"}},
    {"type":"basic","name":"P","text":"{{plan.data?.id ?? '-'}}"},{"type":"basic","name":"P","text":"{{plan.data?.correlation_id ?? '-'}}"},{"type":"basic","name":"P","text":"{{plan.data?.definition_type ?? '-'}}"},{"type":"basic","name":"P","text":"{{plan.data?.recipient_label ?? '-'}}"},{"type":"basic","name":"P","text":"{{plan.data?.channel ?? '-'}}"},{"type":"basic","name":"P","text":"{{plan.data?.last_error_message ?? '-'}}"},
    {"id":"cancel_plan_button","permissions":["glitter-notification_hub.plans.cancel"],"type":"basic","name":"Button","if":"{{['pending','scheduled','retry_scheduled','claimed'].includes(plan.data?.status)}}","props":{"type":"button"},"text":"$t:glitter-notification_hub.admin.actions.cancel","actions":[{"type":"click","handler":"openModal","target":"cancel_plan_modal"}]},
    {"id":"retry_plan_button","permissions":["glitter-notification_hub.plans.retry"],"type":"basic","name":"Button","if":"{{['failed','skipped','cancelled','expired'].includes(plan.data?.status)}}","props":{"type":"button"},"text":"$t:glitter-notification_hub.admin.actions.retry","actions":[{"type":"click","handler":"openModal","target":"retry_plan_modal"}]},
    {"type":"basic","name":"H2","text":"$t:glitter-notification_hub.admin.sections.attempts"},
    {"id":"plan_attempt_rows","type":"basic","name":"Div","iteration":{"source":"plan_attempts.data.data","item_var":"attempt","index_var":"attemptIndex"},"children":[{"type":"basic","name":"Button","props":{"type":"button"},"text":"{{attempt.id}}","actions":[{"type":"click","handler":"navigate","params":{"path":"/admin/modules/glitter-notification_hub/attempts/{{attempt.id}}"}}]}]}
  ]}]},
  "modals":[
    {"id":"cancel_plan_modal","permissions":["glitter-notification_hub.plans.cancel"],"type":"composite","name":"Modal","props":{"title":"$t:glitter-notification_hub.admin.modals.cancel.title","size":"medium"},"children":[
      {"type":"basic","name":"P","text":"$t:glitter-notification_hub.admin.modals.cancel.help"},
      {"type":"basic","name":"Textarea","props":{"value":"{{_global.notificationHubPlanAction.reason}}","maxLength":500,"placeholder":"$t:glitter-notification_hub.admin.placeholders.cancel_reason"},"actions":[{"type":"change","handler":"setState","params":{"target":"global","notificationHubPlanAction.reason":"{{$event.target.value}}"}}]},
      {"type":"basic","name":"Button","props":{"type":"button"},"text":"$t:common.cancel","actions":[{"type":"click","handler":"closeModal"}]},
      {"type":"basic","name":"Button","props":{"type":"button"},"text":"$t:glitter-notification_hub.admin.actions.confirm_cancel","actions":[{"type":"click","handler":"apiCall","auth_required":true,"target":"/api/modules/glitter-notification_hub/admin/plans/{{route.id}}/cancel","params":{"method":"POST","body":{"reason":"{{_global.notificationHubPlanAction.reason}}"}},"onSuccess":[{"handler":"refetchDataSource","params":{"dataSourceId":"plan"}},{"handler":"toast","params":{"type":"success","message":"$t:glitter-notification_hub.admin.success.plan_cancelled"}},{"handler":"closeModal"}],"onError":[{"handler":"toast","params":{"type":"error","message":"{{error.message ?? '$t:glitter-notification_hub.admin.errors.action_failed'}}"}}]}]}
    ]},
    {"id":"retry_plan_modal","permissions":["glitter-notification_hub.plans.retry"],"type":"composite","name":"Modal","props":{"title":"$t:glitter-notification_hub.admin.modals.retry_plan.title","size":"medium"},"children":[
      {"type":"basic","name":"P","text":"$t:glitter-notification_hub.admin.modals.retry.help"},
      {"type":"basic","name":"Textarea","props":{"value":"{{_global.notificationHubPlanAction.reason}}","required":true,"maxLength":500,"placeholder":"$t:glitter-notification_hub.admin.placeholders.retry_reason"},"actions":[{"type":"change","handler":"setState","params":{"target":"global","notificationHubPlanAction.reason":"{{$event.target.value}}"}}]},
      {"type":"basic","name":"Input","props":{"type":"datetime-local","value":"{{_global.notificationHubPlanAction.scheduledAt}}"},"actions":[{"type":"change","handler":"setState","params":{"target":"global","notificationHubPlanAction.scheduledAt":"{{$event.target.value}}"}}]},
      {"type":"basic","name":"Select","props":{"value":"{{_global.notificationHubPlanAction.retryPolicy}}","options":[{"value":"none","label":"$t:glitter-notification_hub.admin.retry_policies.none"},{"value":"standard","label":"$t:glitter-notification_hub.admin.retry_policies.standard"},{"value":"aggressive","label":"$t:glitter-notification_hub.admin.retry_policies.aggressive"}]},"actions":[{"type":"change","handler":"setState","params":{"target":"global","notificationHubPlanAction.retryPolicy":"{{$event.target.value}}"}}]},
      {"type":"basic","name":"Input","props":{"type":"number","min":1,"max":20,"value":"{{_global.notificationHubPlanAction.maxAttempts}}"},"actions":[{"type":"change","handler":"setState","params":{"target":"global","notificationHubPlanAction.maxAttempts":"{{$event.target.value}}"}}]},
      {"type":"basic","name":"Button","props":{"type":"button"},"text":"$t:common.cancel","actions":[{"type":"click","handler":"closeModal"}]},
      {"id":"retry_plan_submit","type":"basic","name":"Button","props":{"type":"button","disabled":"{{_global.notificationHubPlanAction.isSubmitting}}"},"text":"$t:glitter-notification_hub.admin.actions.retry","actions":[{"type":"click","handler":"sequence","actions":[{"handler":"setState","params":{"target":"global","notificationHubPlanAction.isSubmitting":true}},{"handler":"apiCall","auth_required":true,"target":"/api/modules/glitter-notification_hub/admin/plans/{{route.id}}/retry","params":{"method":"POST","body":{"reason":"{{_global.notificationHubPlanAction.reason}}","scheduled_at":"{{_global.notificationHubPlanAction.scheduledAt || undefined}}","retry_policy":"{{_global.notificationHubPlanAction.retryPolicy}}","max_attempts":"{{Number(_global.notificationHubPlanAction.maxAttempts)}}"}},"onSuccess":[{"handler":"setState","params":{"target":"global","notificationHubPlanAction.isSubmitting":false}},{"handler":"toast","params":{"type":"success","message":"$t:glitter-notification_hub.admin.success.plan_retry_created"}},{"handler":"closeModal"},{"handler":"navigate","params":{"path":"/admin/modules/glitter-notification_hub/plans/{{response.data.plan_id}}"}}],"onError":[{"handler":"setState","params":{"target":"global","notificationHubPlanAction.isSubmitting":false}},{"handler":"toast","params":{"type":"error","message":"{{error.message ?? '$t:glitter-notification_hub.admin.errors.retry_failed'}}"}}]}]}]}
    ]}
  ]
}
