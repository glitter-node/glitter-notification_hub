{
  "version":"1.0.0","layout_name":"dead_letter_detail","permissions":["glitter-notification_hub.dead-letters.read"],"extends":"_admin_base",
  "meta":{"title":"$t:glitter-notification_hub.admin.pages.dead_letter_detail.title"},
  "initGlobal":{"notificationHubDeadLetterAction":{"resolutionNote":"","reason":"","scheduledAt":"","retryPolicy":"standard","maxAttempts":6,"isSubmitting":false}},
  "data_sources":[{"id":"dead_letter","type":"api","endpoint":"/api/modules/glitter-notification_hub/admin/dead-letters/{{route.id}}","method":"GET","auto_fetch":true,"auth_required":true,"errorHandling":{"404":{"handler":"showErrorPage","params":{"target":"content"}}}}],
  "slots":{"content":[{"id":"dead_letter_detail_page","type":"basic","name":"Div","props":{"className":"admin-page-content"},"children":[
    {"type":"composite","name":"PageHeader","props":{"title":"$t:glitter-notification_hub.admin.pages.dead_letter_detail.title"}},
    {"type":"basic","name":"Badge","props":{"label":"{{dead_letter.data?.resolved ? '$t:glitter-notification_hub.admin.boolean.resolved' : '$t:glitter-notification_hub.admin.boolean.unresolved'}}"}},
    {"type":"basic","name":"P","text":"{{dead_letter.data?.id ?? '-'}}"},{"type":"basic","name":"P","text":"{{dead_letter.data?.reason_code ?? '-'}}"},{"type":"basic","name":"P","text":"{{dead_letter.data?.reason_message ?? '-'}}"},{"type":"basic","name":"P","text":"{{dead_letter.data?.resolution_note ?? '-'}}"},
    {"type":"basic","name":"Button","props":{"type":"button"},"text":"$t:glitter-notification_hub.admin.actions.view_plan","actions":[{"type":"click","handler":"navigate","params":{"path":"/admin/modules/glitter-notification_hub/plans/{{dead_letter.data?.plan_id}}"}}]},
    {"id":"resolve_dead_letter_button","permissions":["glitter-notification_hub.dead-letters.resolve"],"type":"basic","name":"Button","if":"{{!dead_letter.data?.resolved}}","props":{"type":"button"},"text":"$t:glitter-notification_hub.admin.actions.resolve","actions":[{"type":"click","handler":"openModal","target":"resolve_dead_letter_modal"}]},
    {"id":"retry_dead_letter_button","permissions":["glitter-notification_hub.dead-letters.retry"],"type":"basic","name":"Button","if":"{{!dead_letter.data?.resolved}}","props":{"type":"button"},"text":"$t:glitter-notification_hub.admin.actions.retry","actions":[{"type":"click","handler":"openModal","target":"retry_dead_letter_modal"}]}
  ]}]},
  "modals":[
    {"id":"resolve_dead_letter_modal","permissions":["glitter-notification_hub.dead-letters.resolve"],"type":"composite","name":"Modal","props":{"title":"$t:glitter-notification_hub.admin.modals.resolve.title","size":"medium"},"children":[
      {"type":"basic","name":"P","text":"$t:glitter-notification_hub.admin.modals.resolve.help"},
      {"type":"basic","name":"Textarea","props":{"value":"{{_global.notificationHubDeadLetterAction.resolutionNote}}","required":true,"maxLength":1000,"placeholder":"$t:glitter-notification_hub.admin.placeholders.resolution_note"},"actions":[{"type":"change","handler":"setState","params":{"target":"global","notificationHubDeadLetterAction.resolutionNote":"{{$event.target.value}}"}}]},
      {"type":"basic","name":"Button","props":{"type":"button"},"text":"$t:common.cancel","actions":[{"type":"click","handler":"closeModal"}]},
      {"type":"basic","name":"Button","props":{"type":"button"},"text":"$t:glitter-notification_hub.admin.actions.resolve","actions":[{"type":"click","handler":"apiCall","auth_required":true,"target":"/api/modules/glitter-notification_hub/admin/dead-letters/{{route.id}}/resolve","params":{"method":"POST","body":{"resolution_note":"{{_global.notificationHubDeadLetterAction.resolutionNote}}"}},"onSuccess":[{"handler":"refetchDataSource","params":{"dataSourceId":"dead_letter"}},{"handler":"toast","params":{"type":"success","message":"$t:glitter-notification_hub.admin.success.dead_letter_resolved"}},{"handler":"closeModal"}],"onError":[{"handler":"toast","params":{"type":"error","message":"{{error.message ?? '$t:glitter-notification_hub.admin.errors.action_failed'}}"}}]}]}
    ]},
    {"id":"retry_dead_letter_modal","permissions":["glitter-notification_hub.dead-letters.retry"],"type":"composite","name":"Modal","props":{"title":"$t:glitter-notification_hub.admin.modals.retry_dead_letter.title","size":"medium"},"children":[
      {"type":"basic","name":"P","text":"$t:glitter-notification_hub.admin.modals.retry.help"},
      {"type":"basic","name":"Textarea","props":{"value":"{{_global.notificationHubDeadLetterAction.reason}}","required":true,"maxLength":500,"placeholder":"$t:glitter-notification_hub.admin.placeholders.retry_reason"},"actions":[{"type":"change","handler":"setState","params":{"target":"global","notificationHubDeadLetterAction.reason":"{{$event.target.value}}"}}]},
      {"type":"basic","name":"Input","props":{"type":"datetime-local","value":"{{_global.notificationHubDeadLetterAction.scheduledAt}}"},"actions":[{"type":"change","handler":"setState","params":{"target":"global","notificationHubDeadLetterAction.scheduledAt":"{{$event.target.value}}"}}]},
      {"type":"basic","name":"Select","props":{"value":"{{_global.notificationHubDeadLetterAction.retryPolicy}}","options":[{"value":"none","label":"$t:glitter-notification_hub.admin.retry_policies.none"},{"value":"standard","label":"$t:glitter-notification_hub.admin.retry_policies.standard"},{"value":"aggressive","label":"$t:glitter-notification_hub.admin.retry_policies.aggressive"}]},"actions":[{"type":"change","handler":"setState","params":{"target":"global","notificationHubDeadLetterAction.retryPolicy":"{{$event.target.value}}"}}]},
      {"type":"basic","name":"Input","props":{"type":"number","min":1,"max":20,"value":"{{_global.notificationHubDeadLetterAction.maxAttempts}}"},"actions":[{"type":"change","handler":"setState","params":{"target":"global","notificationHubDeadLetterAction.maxAttempts":"{{$event.target.value}}"}}]},
      {"type":"basic","name":"Button","props":{"type":"button"},"text":"$t:common.cancel","actions":[{"type":"click","handler":"closeModal"}]},
      {"id":"retry_dead_letter_submit","type":"basic","name":"Button","props":{"type":"button","disabled":"{{_global.notificationHubDeadLetterAction.isSubmitting}}"},"text":"$t:glitter-notification_hub.admin.actions.retry","actions":[{"type":"click","handler":"sequence","actions":[{"handler":"setState","params":{"target":"global","notificationHubDeadLetterAction.isSubmitting":true}},{"handler":"apiCall","auth_required":true,"target":"/api/modules/glitter-notification_hub/admin/dead-letters/{{route.id}}/retry","params":{"method":"POST","body":{"reason":"{{_global.notificationHubDeadLetterAction.reason}}","scheduled_at":"{{_global.notificationHubDeadLetterAction.scheduledAt || undefined}}","retry_policy":"{{_global.notificationHubDeadLetterAction.retryPolicy}}","max_attempts":"{{_global.notificationHubDeadLetterAction.maxAttempts}}"}},"onSuccess":[{"handler":"setState","params":{"target":"global","notificationHubDeadLetterAction.isSubmitting":false}},{"handler":"refetchDataSource","params":{"dataSourceId":"dead_letter"}},{"handler":"toast","params":{"type":"success","message":"$t:glitter-notification_hub.admin.success.dead_letter_retry_created"}},{"handler":"closeModal"},{"handler":"navigate","params":{"path":"/admin/modules/glitter-notification_hub/plans/{{response.data.plan_id}}"}}],"onError":[{"handler":"setState","params":{"target":"global","notificationHubDeadLetterAction.isSubmitting":false}},{"handler":"toast","params":{"type":"error","message":"{{error.message ?? '$t:glitter-notification_hub.admin.errors.retry_failed'}}"}}]}]}]}
    ]}
  ]
}
