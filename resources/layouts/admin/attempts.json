    ]}]},
    {"id":"attempts_results","type":"basic","name":"Div","props":{"className":"flex flex-col gap-3"},"children":[
      {"id":"attempts_empty","type":"basic","name":"P","props":{"className":"admin-card"},"if":"{{(attempts?.data?.data || []).length === 0}}","text":"$t:glitter-notification_hub.admin.empty.attempts"},
      {"id":"attempt_rows","type":"basic","name":"Div","iteration":{"source":"attempts.data.data","item_var":"attempt","index_var":"attemptIndex"},"children":[{"type":"basic","name":"Div","props":{"className":"admin-card"},"children":[{"type":"basic","name":"Badge","props":{"label":"{{attempt.status}}"}},{"type":"basic","name":"Span","text":"{{attempt.plan_id}}"},{"type":"basic","name":"Span","text":"{{attempt.attempt_number}}"},{"type":"basic","name":"Span","text":"{{attempt.provider ?? '-'}}"},{"type":"basic","name":"Span","text":"{{attempt.duration_ms ?? '-'}}"},{"type":"basic","name":"Span","text":"{{attempt.error_code ?? '-'}}"},{"type":"basic","name":"Button","props":{"type":"button"},"text":"$t:glitter-notification_hub.admin.actions.view","actions":[{"type":"click","handler":"navigate","params":{"path":"/admin/modules/glitter-notification_hub/attempts/{{attempt.id}}"}}]}]}]}
    ]}
  ]}]}
