      {"type":"basic","name":"Div","props":{"className":"flex flex-col gap-2 flex-1 min-w-48"},"children":[{"type":"basic","name":"Span","text":"$t:glitter-notification_hub.admin.labels.provider"},{"id":"attempts_provider","type":"basic","name":"Input","props":{"type":"text","value":"{{_local.provider}}","placeholder":"$t:glitter-notification_hub.admin.placeholders.provider","aria-label":"$t:glitter-notification_hub.admin.labels.provider","className":"bg-white border border-gray-300 dark:bg-gray-800 dark:border-gray-600"},"actions":[{"type":"change","handler":"setState","params":{"target":"_local","provider":"{{$event.target.value}}","page":1}},{"type":"keypress","key":"Enter","handler":"refetchDataSource","params":{"dataSourceId":"attempts"}}]}]},
